# 服务监听端口（默认 8080）
PORT=8080

# 监听地址（容器内默认 0.0.0.0）
HOST=0.0.0.0

# PostgreSQL 连接串（docker-compose 默认自动注入；Coolify 可直接绑定托管 Postgres 的 DATABASE_URL）
DATABASE_URL=postgresql://tower:tower_change_me@postgres:5432/tower

# PostgreSQL SSL 模式：disable | require | no-verify（托管云数据库通常设为 require 或 no-verify）
DATABASE_SSL=disable

# docker-compose 附带的 PostgreSQL 容器初始账号配置
POSTGRES_DB=tower
POSTGRES_USER=tower
POSTGRES_PASSWORD=tower_change_me

# 管理员密码（生产公网部署强烈建议通过环境变量预先配置，防止首次启动被抢注；留空则首次打开网页时设置）
ADMIN_PASSWORD=

# 应用层敏感字段加密密钥（推荐 32 字节 hex 或任意强随机串，用于 AES-256-GCM 加密订阅链接、节点凭据与导出 Token）
ENCRYPTION_KEY=

# 会话签名密钥（留空则首次启动自动生成并持久化到 PostgreSQL）
SESSION_SECRET=

# 是否允许服务端拉取私网/回环/Fake-IP 地址（默认 false 防御 SSRF；透明代理/内网环境可设为 true）
ALLOW_PRIVATE_FETCH=false

# 对外访问的完整根地址，用于生成托管订阅链接与客户端一键导入链接（例如 https://tower.example.com；留空时自动取请求 Host）
PUBLIC_BASE_URL=

# 位于反向代理（Coolify / Traefik / Nginx / Caddy）后时设为 true 以识别 X-Forwarded-Proto/Host
TRUST_PROXY=true
